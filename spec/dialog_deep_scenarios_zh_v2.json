[
  {
    "id": "E001",
    "group": "execution",
    "title": "购物车加购-结算-支付闭环",
    "steps": [
      {
        "user": "把软管加入购物车2件",
        "expect_lane": "action",
        "expect_pending_type": "CART_ADD",
        "expect_confirm_required": true,
        "expect_any": [
          "确认",
          "购物车"
        ]
      },
      {
        "user": "确认",
        "expect_lane": "action",
        "expect_any": [
          "购物车",
          "合计"
        ],
        "post_assert_api": {
          "method": "GET",
          "path": "/api/portal/cart/items",
          "expect": {
            "status_code": 200,
            "equals": {
              "ok": true
            },
            "gte": {
              "data.selected_count": 1
            }
          }
        }
      },
      {
        "user": "结算购物车",
        "expect_lane": "action",
        "expect_pending_type": "CART_CHECKOUT",
        "expect_confirm_required": true,
        "expect_any": [
          "确认",
          "结算"
        ]
      },
      {
        "user": "确认",
        "expect_lane": "action",
        "expect_any": [
          "支付成功",
          "下单并支付成功",
          "订单"
        ],
        "post_assert_api": {
          "method": "GET",
          "path": "/api/portal/cart/items",
          "expect": {
            "status_code": 200,
            "equals": {
              "ok": true,
              "data.selected_count": 0
            }
          }
        }
      }
    ]
  },
  {
    "id": "E002",
    "group": "execution",
    "title": "账户昵称修改闭环",
    "steps": [
      {
        "user": "把我的用户名改成测试用户A",
        "expect_lane": "action",
        "expect_pending_type": "UPDATE_PROFILE",
        "expect_confirm_required": true,
        "expect_any": [
          "确认",
          "姓名"
        ]
      },
      {
        "user": "确认",
        "expect_lane": "action",
        "expect_any": [
          "已更新",
          "姓名"
        ],
        "post_assert_api": {
          "method": "GET",
          "path": "/api/portal/me",
          "expect": {
            "status_code": 200,
            "equals": {
              "ok": true,
              "data.display_name": "测试用户A"
            }
          }
        }
      }
    ]
  },
  {
    "id": "E003",
    "group": "execution",
    "title": "服务下单并支付闭环",
    "steps": [
      {
        "user": "我要下单 15kg 一瓶",
        "expect_lane": "action",
        "expect_pending_type": "CREATE_ORDER",
        "expect_any": [
          "服务类型",
          "确认"
        ]
      },
      {
        "user": "用默认地址，尽快送，不加急",
        "expect_lane": "action",
        "expect_pending_type": "CREATE_ORDER",
        "expect_confirm_required": true,
        "expect_any": [
          "确认",
          "服务类型"
        ]
      },
      {
        "user": "确认下单",
        "expect_lane": "action",
        "expect_any": [
          "订单",
          "已生成",
          "待支付"
        ]
      },
      {
        "user": "支付这单",
        "expect_lane": "action",
        "expect_pending_type": "PAY_ORDER",
        "expect_confirm_required": true,
        "expect_any": [
          "确认",
          "支付"
        ]
      },
      {
        "user": "确认",
        "expect_lane": "action",
        "expect_any": [
          "支付成功",
          "订单"
        ],
        "post_assert_api": {
          "method": "GET",
          "path": "/api/portal/orders?status=PAID&page=1&page_size=1",
          "expect": {
            "status_code": 200,
            "equals": {
              "ok": true
            },
            "gte": {
              "data.total": 1
            }
          }
        }
      }
    ]
  },
  {
    "id": "E004",
    "group": "execution",
    "title": "订单查询执行链",
    "steps": [
      {
